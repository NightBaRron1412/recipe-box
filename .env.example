# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_WEBHOOK_SECRET=some-random-hex
# قصر البوت على معرفك أنت فقط (رقمي). أرسل /start للبوت لمعرفته.
ALLOWED_TELEGRAM_USER_ID=

# --- Supabase ---
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ... (secret, server only)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ... (anon)

# --- Gemini (recipe extraction) ---
GEMINI_API_KEY=

# --- App ---
# رابط الموقع بعد النشر على Vercel (يستخدم في رسائل تيليجرام)
APP_BASE_URL=https://recipe-box.vercel.app
